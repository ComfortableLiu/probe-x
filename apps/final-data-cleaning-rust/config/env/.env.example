# Rust 独立最终清洗节点。环境变量优先；开发时缺失项会回退到原 Node 服务的 env 文件。
# 节点身份独立于 Node 的 NODE_ID / NODE_NAME，避免两版在同机时互相顶掉连接。
RUST_NODE_ID=
RUST_NODE_NAME=Rust计算节点
# 留空自动使用进程可用 CPU 并行度；专用清洗节点默认满核。
RUST_CLEANING_THREADS=
# I/O任务槽默认CPU线程数的4倍；CPU池仍按上项，内存紧张可降低此值。
RUST_TASK_CONCURRENCY=
RUST_HEALTH_HOST=127.0.0.1
RUST_HEALTH_PORT=10001
MASTER_HOST=localhost
MASTER_PORT=8105
NODE_ADVERTISE_ADDRESS=
# 默认自动获取节点地址，必要时设置为对外主机名/IP（不含协议、端口）。
# 对外映射的健康端口，留空使用实际监听端口；不会改变健康检查监听配置。
NODE_ADVERTISE_PORT=
HEARTBEAT_INTERVAL_MS=5000
NODE_LOG_FLUSH_INTERVAL_MS=2000
CLEANING_DETAIL_LOG_ENABLED=false

# 同时限制行数和字节，避免单个超大会话整批驻留内存。
RUST_BATCH_SIZE=1000
# 同一张表可合并不同会话的输出，最长等待毫秒；0 禁用跨调用合批。
RUST_WRITE_BATCH_WAIT_MS=10
RUST_MAX_BATCH_BYTES=8388608
RUST_MAX_EVENT_BYTES=1048576
RUST_MAX_ATTRIBUTIONS_PER_BATCH=100000
RUST_SLICE_LEASE_SECONDS=120
RUST_SHUTDOWN_TIMEOUT_SECONDS=60

CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=probe_x
CLICKHOUSE_REQUEST_TIMEOUT=30000
CLICKHOUSE_CONNECTION_TIMEOUT=10000
CLICKHOUSE_REJECT_UNAUTHORIZED=true
CLICKHOUSE_COMPRESSION=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_TLS_ENABLED=false
REDIS_CLUSTER_ENABLED=false
# 集群模式只支持 DB 0；使用 host:port 列表，认证使用上方字段。
REDIS_CLUSTER_NODES=
