# 请求签名密钥
SIGNATURE_SECRET=xxxxxxxxxxxxxxxxxxxxx

# 登录盐
SALT=xxxxxxx

# 登录HMAC密钥
HMAC_SECRET=xxxxxxxxxxx

# JWT令牌
JWT_SECRET=xxxxxxxxxxxxx
# JWT令牌有效期，秒
JWT_EXPIRES_IN=86400
# JWT刷新令牌有效期，秒
JWT_REFRESH_EXPIRES_IN=604800

# 前端
CLIENT_HOST=http://localhost
CLIENT_POST=8000

# SSO页面地址
SSO=http://localhost:8000

# 前端系统提供api的服务
DATA_DASHBOARD_API_SERVICE_HOST=http://localhost
DATA_DASHBOARD_API_SERVICE_POST=8101

# 最终清洗服务
FINAL_DATA_CLEANING_SERVICE_HOST=http://localhost
FINAL_DATA_CLEANING_SERVICE_POST=8102

# 初步清洗服务
PRELIMINARY_DATA_PROCESSING_SERVICE_HOST=http://localhost
PRELIMINARY_DATA_PROCESSING_SERVICE_POST=8103

# 埋点接收api服务
RECEIVING_POINT_SERVICE_HOST=http://localhost
RECEIVING_POINT_SERVICE_POST=8104

# mysql数据库配置
DB_HOST=your_db_host
DB_PORT=3306
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=your_db
DB_SYNCHRONIZE=false

# clickhouse数据库配置
# ClickHouse HTTP 接口地址（默认端口 8123）
CLICKHOUSE_HOST=http://localhost:8123
# 用户名（默认：default）
CLICKHOUSE_USER=default
# 密码（默认空，生产环境建议设置）
CLICKHOUSE_PASSWORD=
# 默认数据库（可选）
CLICKHOUSE_DATABASE=default
# 是否启用 TLS（true/false，默认 false）
CLICKHOUSE_TLS=true
# 开发环境可禁用证书验证（生产环境建议 true）
CLICKHOUSE_REJECT_UNAUTHORIZED=false
# 单个请求超时时间（默认 30 秒）
CLICKHOUSE_REQUEST_TIMEOUT=30000
# 连接建立超时时间（默认 10 秒）
CLICKHOUSE_CONNECTION_TIMEOUT=10000
# 是否启用数据压缩（默认 true）
CLICKHOUSE_COMPRESSION=true

# kafka配置
# Kafka 集群 Broker 列表（多个用逗号分隔，格式：host:port）
KAFKA_BROKERS=localhost:9092,localhost:9093,localhost:9094
# 客户端 ID（标识当前服务，用于 Kafka 监控和日志）
KAFKA_CLIENT_ID=nestjs-kafka-service
# 默认消费组 ID（消费者必配，同一组内消息仅被消费一次）
KAFKA_CONSUMER_GROUP_ID=nestjs-consumer-group-v1
# 认证类型：none（默认）/ sasl_plaintext / sasl_ssl
KAFKA_AUTH_TYPE=none
# SASL 认证用户名（仅 sasl_plaintext/sasl_ssl 需配置）
KAFKA_SASL_USERNAME=admin
# SASL 认证密码（仅 sasl_plaintext/sasl_ssl 需配置）
KAFKA_SASL_PASSWORD=admin123
# 是否启用 SSL（true/false，sasl_ssl 需设为 true）
KAFKA_SSL_ENABLED=false
# 开发环境可禁用 SSL 证书验证（生产环境必须设为 true）
KAFKA_SSL_REJECT_UNAUTHORIZED=false
# 连接 Broker 超时时间（毫秒）
KAFKA_CONNECTION_TIMEOUT=10000
# 发送消息超时时间（毫秒）
KAFKA_REQUEST_TIMEOUT=30000
# 消息发送重试次数（失败自动重试）
KAFKA_RETRY_COUNT=3
# 重试间隔时间（毫秒）
KAFKA_RETRY_DELAY=1000
# 消费者从最新消息开始消费（latest）/ 从最早消息开始（earliest）
KAFKA_CONSUMER_AUTO_OFFSET_RESET=latest
# 是否自动提交消费偏移量（true/false，手动提交需设为 false）
KAFKA_CONSUMER_ENABLE_AUTO_COMMIT=true
# 自动提交偏移量的间隔时间（毫秒，仅 auto_commit=true 生效）
KAFKA_CONSUMER_AUTO_COMMIT_INTERVAL=5000
# 批量消费的最大消息数（提高消费效率）
KAFKA_CONSUMER_BATCH_SIZE=100

# redis配置
# Redis 服务器地址（默认 localhost）
REDIS_HOST=localhost
# Redis 端口（默认 6379）
REDIS_PORT=6379
# 密码（若 Redis 配置了 requirepass，则必填）
REDIS_PASSWORD=your-redis-password
# 数据库编号（默认 0，Redis 支持 0-15 共 16 个库）
REDIS_DB=0
# 最大连接数（默认 10）
REDIS_MAX_CONNECTIONS=10
# 最小空闲连接数（默认 2）
REDIS_MIN_IDLE_CONNECTIONS=2
# 连接超时时间（毫秒，默认 10000）
REDIS_CONNECT_TIMEOUT=10000
# 命令执行超时时间（毫秒，默认 5000）
REDIS_COMMAND_TIMEOUT=5000
# 是否启用 TLS（true/false，默认 false，适用于 Redis Cloud 等场景）
REDIS_TLS_ENABLED=false
# 重试策略：初始重试延迟（毫秒）
REDIS_RETRY_DELAY=1000
# 最大重试次数（默认 3 次，0 表示不重试）
REDIS_MAX_RETRY_ATTEMPTS=3
# 是否启用集群模式（true/false，默认 false）
REDIS_CLUSTER_ENABLED=false
# 集群节点列表（多个用逗号分隔，格式：host:port）
REDIS_CLUSTER_NODES=localhost:6379,localhost:6380,localhost:6381

# MinIO 核心配置（必须正确填写）
# 你的 MinIO 服务器 IP 或域名
MINIO_HOST=127.0.0.1
# MinIO API 端口（默认 9000）
MINIO_PORT=9000
# 未配置 HTTPS 则填 false（生产环境建议开启 HTTPS）
MINIO_SSL=false
# 你的 MINIO_ROOT_USER（部署时设置的）
MINIO_ACCESS_KEY=user_name
# 你的 MINIO_ROOT_PASSWORD（部署时设置的）
MINIO_SECRET_KEY=password
# 你在 MinIO Console 中创建的桶名
MINIO_BUCKET=bucket_name
# 预签名下载链接有效期（秒），默认 24 小时
MINIO_DOWNLOAD_EXPIRES=86400
