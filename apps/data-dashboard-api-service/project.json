{
  "name": "data-dashboard-api-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/data-dashboard-api-service/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/data-dashboard-api-service",
        "main": "apps/data-dashboard-api-service/src/main.ts",
        "tsConfig": "apps/data-dashboard-api-service/tsconfig.json"
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "inspect": false
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "data-dashboard-api-service:build",
        "port": 3001
      },
      "configurations": {
        "production": {
          "buildTarget": "data-dashboard-api-service:build:production"
        }
      }
    }
  },
  "tags": []
}
