{
  "compilerOptions": {
    "target": "es2017",
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@pages/*": [
        "src/pages/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ],
      "@router/*": [
        "src/router/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@public/*": [
        "public/*"
      ],
      "@config": [
        "config/configuration"
      ],
      "@shared-types": [
        "../../dist/libs/shared-types"
      ],
      "@shared-utils": [
        "../../dist/libs/shared-utils"
      ]
    }
  }
}
