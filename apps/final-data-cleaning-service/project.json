{
  "name": "final-data-cleaning-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/final-data-cleaning-service/src",
  "projectType": "application",
  "targets": {
    "build": {
      "command": "cd apps/final-data-cleaning-service && yarn run build"
    },
    "serve": {
      "command": "cd apps/final-data-cleaning-service && yarn run dev"
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn test",
        "cwd": "apps/final-data-cleaning-service"
      }
    }
  },
  "implicitDependencies": [
    "shared-types",
    "shared-utils"
  ]
}
