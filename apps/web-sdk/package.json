{
  "name": "@probe-x/web-sdk",
  "version": "0.1.0",
  "description": "Probe-X Web SDK - 轻量级 Web 埋点数据收集 SDK，支持自动埋点、手动埋点、性能监控、会话管理",
  "type": "module",
  "main": "dist/probe-x-sdk.cjs.js",
  "module": "dist/probe-x-sdk.esm.js",
  "types": "dist/probe-x-sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/probe-x-sdk.d.ts",
      "import": "./dist/probe-x-sdk.esm.js",
      "require": "./dist/probe-x-sdk.cjs.js",
      "default": "./dist/probe-x-sdk.esm.js"
    },
    "./dist/*": "./dist/*"
  },
  "unpkg": "dist/probe-x-sdk.umd.min.js",
  "jsdelivr": "dist/probe-x-sdk.umd.min.js",
  "sideEffects": false,
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "dev": "rollup -c -w",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist",
    "size": "size-limit",
    "prepublishOnly": "npm run clean && npm run type-check && npm run build",
    "prepack": "npm run clean && npm run build"
  },
  "keywords": [
    "analytics",
    "tracking",
    "web-analytics",
    "埋点",
    "数据分析",
    "data-collection",
    "telemetry",
    "user-tracking",
    "event-tracking",
    "performance-monitoring",
    "auto-tracking",
    "heatmap",
    "session-replay",
    "typescript",
    "probe-x"
  ],
  "author": "逍遥成居士 <liuchengxu1994@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ComfortableLiu/probe-x.git",
    "directory": "apps/web-sdk"
  },
  "bugs": {
    "url": "https://github.com/ComfortableLiu/probe-x/issues"
  },
  "homepage": "https://github.com/ComfortableLiu/probe-x/tree/main/apps/web-sdk#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "size-limit": [
    {
      "path": "dist/probe-x-sdk.esm.js",
      "limit": "50 kB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.5",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rimraf": "^5.0.5",
    "rollup": "^4.3.0",
    "rollup-plugin-dts": "^6.1.0",
    "size-limit": "^11.0.0",
    "ts-jest": "^29.1.1",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "uuid": "^9.0.1"
  }
}
