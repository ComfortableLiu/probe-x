{
  "name": "@probe-x/web-sdk",
  "version": "1.0.0",
  "description": "Probe-X Web SDK - 埋点数据收集SDK (TypeScript版本)",
  "type": "module",
  "main": "dist/probe-x-sdk.js",
  "module": "dist/probe-x-sdk.esm.js",
  "types": "dist/probe-x-sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/probe-x-sdk.d.ts",
      "import": "./dist/probe-x-sdk.esm.js",
      "require": "./dist/probe-x-sdk.cjs.js",
      "default": "./dist/probe-x-sdk.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "dev": "rollup -c -w",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run type-check && npm run build"
  },
  "keywords": [
    "analytics",
    "tracking",
    "sdk",
    "web",
    "埋点",
    "数据收集"
  ],
  "author": "逍遥成居士 <liuchengxu1994@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ComfortableLiu/probe-x.git",
    "directory": "apps/web-sdk"
  },
  "bugs": {
    "url": "https://github.com/ComfortableLiu/probe-x/issues"
  },
  "homepage": "https://github.com/ComfortableLiu/probe-x#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "rollup": "^4.3.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.1.0",
    "ts-jest": "^29.1.1",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "uuid": "^9.0.1"
  }
}
