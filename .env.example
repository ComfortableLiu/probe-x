# Probe-X 环境变量配置示例
# 复制此文件为 .env 并修改配置

# ==================== MySQL 配置 ====================
# MySQL root 密码（必须修改为强密码！）
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
# MySQL 端口（宿主机映射）
MYSQL_PORT=3306
# 数据库用户名
DB_USERNAME=probe_x
# 数据库密码（必须修改为强密码！）
DB_PASSWORD=change-me-db-password
# 数据库名称
DB_DATABASE=probe_x

# ==================== Kafka 配置 ====================
# Kafka 外部访问端口
KAFKA_EXTERNAL_PORT=9092

# ==================== ClickHouse 配置 ====================
# ClickHouse HTTP 端口
CLICKHOUSE_HTTP_PORT=8123
# ClickHouse TCP 端口
CLICKHOUSE_TCP_PORT=9000
# ClickHouse 用户名
CLICKHOUSE_USER=default
# ClickHouse 密码（生产环境建议设置）
CLICKHOUSE_PASSWORD=
# ClickHouse 数据库名称
CLICKHOUSE_DATABASE=probe_x

# ==================== Redis 配置 ====================
# Redis 端口
REDIS_PORT=6379
# Redis 密码（必须修改为强密码！）
REDIS_PASSWORD=change-me-redis-password

# ==================== 前端配置 ====================
# 前端访问端口
FRONTEND_PORT=80

# ==================== 后端服务配置 ====================
# 数据接收服务端口
RECEIVING_POINT_SERVICE_PORT=8104
# 初步数据处理服务端口
PRELIMINARY_DATA_PROCESSING_SERVICE_PORT=8103
# 最终数据清洗服务端口
FINAL_DATA_CLEANING_SERVICE_PORT=10000
# 数据仪表板 API 服务端口
DATA_DASHBOARD_API_SERVICE_PORT=8101

# ==================== 安全配置 ====================
# 请求签名密钥（必须修改！）
SIGNATURE_SECRET=your_signature_secret_here_please_change
# 登录盐（必须修改！）
SALT=your_salt_here_please_change
# 登录 HMAC 密钥（必须修改！）
HMAC_SECRET=your_hmac_secret_here_please_change
# JWT 令牌密钥（必须修改！）
JWT_SECRET=your_jwt_secret_here_please_change
# JWT 令牌有效期（秒）
JWT_EXPIRES_IN=86400
# JWT 刷新令牌有效期（秒）
JWT_REFRESH_EXPIRES_IN=604800

# ==================== MinIO 配置（可选） ====================
# MinIO 服务器地址
MINIO_HOST=127.0.0.1
# MinIO API 端口
MINIO_PORT=9000
# 是否启用 SSL
MINIO_SSL=false
# MinIO 访问密钥
MINIO_ACCESS_KEY=minioadmin
# MinIO 密钥
MINIO_SECRET_KEY=minioadmin
# MinIO 存储桶名称
MINIO_BUCKET=probe-x
