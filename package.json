{
  "name": "probe-x",
  "version": "0.0.1",
  "description": "ProbeX，探针，一款Web数据分析解决方案",
  "homepage": "https://github.com/ComfortableLiu/probe-x#readme",
  "bugs": {
    "url": "https://github.com/ComfortableLiu/probe-x/issues"
  },
  "repository": "git+git@github.com:ComfortableLiu/probe-x.git",
  "license": "MIT",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "nx": "nx",
    "start:frontend": "nx serve frontend",
    "start:receiving-point": "nx serve receiving-point-service",
    "start:dashboard-api": "nx serve data-dashboard-api-service",
    "start:preliminary-processing": "nx serve preliminary-data-processing-service",
    "start:final-cleaning": "nx serve final-data-cleaning-service",
    "start:web-sdk": "nx dev web-sdk",
    "build:frontend": "nx build frontend",
    "build:receiving-point": "nx build receiving-point-service",
    "build:dashboard-api": "nx build data-dashboard-api-service",
    "build:preliminary-processing": "nx build preliminary-data-processing-service",
    "build:final-cleaning": "nx build final-data-cleaning-service",
    "build:web-sdk": "nx build web-sdk",
    "build:shared-types": "nx build shared-types",
    "build:lib": "nx run-many --target=build --projects=shared-types --parallel",
    "dev": "nx run-many --target=serve --projects=frontend,receiving-point-service,data-dashboard-api-service,preliminary-data-processing-service,final-data-cleaning-service --parallel",
    "dev:frontend": "nx run-many --target=serve --projects=frontend --parallel",
    "dev:backend": "nx run-many --target=serve --projects=receiving-point-service,data-dashboard-api-service,preliminary-data-processing-service,final-data-cleaning-service --parallel",
    "dev:services": "nx run-many --target=serve --projects=receiving-point-service,data-dashboard-api-service,preliminary-data-processing-service,final-data-cleaning-service --parallel",
    "dev:web-sdk": "nx dev web-sdk",
    "build": "nx run-many --target=build --projects=frontend,receiving-point-service,data-dashboard-api-service,preliminary-data-processing-service,final-data-cleaning-service,shared-types,web-sdk --parallel",
    "build:sequence": "nx run-many --target=build --projects=shared-types,receiving-point-service,data-dashboard-api-service,preliminary-data-processing-service,final-data-cleaning-service,frontend,web-sdk --sequence",
    "build:frontend-only": "nx run-many --target=build --projects=frontend --parallel",
    "build:backend-only": "nx run-many --target=build --projects=receiving-point-service,data-dashboard-api-service,preliminary-data-processing-service,final-data-cleaning-service --parallel",
    "build:sdk-only": "nx run-many --target=build --projects=web-sdk --parallel",
    "clean": "nx reset && rm -rf dist",
    "clean:all": "nx reset && rm -rf dist && rm -rf node_modules && rm -rf apps/*/node_modules && rm -rf libs/*/node_modules",
    "test": "nx run-many --target=test --all --parallel",
    "test:frontend": "nx test frontend",
    "test:receiving-point": "nx test receiving-point-service",
    "test:dashboard-api": "nx test data-dashboard-api-service",
    "test:preliminary-processing": "nx test preliminary-data-processing-service",
    "test:final-cleaning": "nx test final-data-cleaning-service",
    "lint": "nx run-many --target=lint --all --parallel",
    "lint:fix": "nx run-many --target=lint --all --fix --parallel",
    "deploy:all": "yarn build && echo '所有服务已打包完成，可以部署到生产环境'",
    "deploy:frontend": "yarn build:frontend && echo '前端已打包完成'",
    "deploy:backend": "yarn build:backend-only && echo '后端服务已打包完成'",
    "stop:all": "pkill -f 'nx serve' || echo '没有运行中的服务'",
    "restart:all": "yarn stop:all && yarn dev",
    "db:migrate": "echo '请在各服务中单独执行数据库迁移'",
    "db:seed": "echo '请在各服务中单独执行数据种子'",
    "status": "ps aux | grep 'nx serve' | grep -v grep || echo '没有运行中的服务'",
    "logs": "echo '请使用 yarn logs:service-name 查看特定服务日志'",
    "logs:frontend": "tail -f apps/frontend/dist/*.log 2>/dev/null || echo '前端日志文件不存在'",
    "logs:receiving-point": "tail -f apps/receiving-point-service/dist/*.log 2>/dev/null || echo '埋点接收服务日志文件不存在'",
    "logs:dashboard-api": "tail -f apps/data-dashboard-api-service/dist/*.log 2>/dev/null || echo '仪表板API服务日志文件不存在'",
    "logs:preliminary-processing": "tail -f apps/preliminary-data-processing-service/dist/*.log 2>/dev/null || echo '初步数据处理服务日志文件不存在'",
    "logs:final-cleaning": "tail -f apps/final-data-cleaning-service/dist/*.log 2>/dev/null || echo '最终数据清洗服务日志文件不存在'"
  },
  "author": "逍遥成居士 <liuchengxu1994@gmail.com>",
  "packageManager": "yarn@1.22.22",
  "devDependencies": {
    "@nx/devkit": "^21.3.10",
    "@nx/rspack": "^21.3.10",
    "@nx/workspace": "^21.3.10",
    "@rspack/cli": "^1.4.11",
    "@rspack/core": "^1.4.11",
    "@rspack/plugin-react-refresh": "^1.4.3",
    "@types/node": "^24.1.0",
    "cross-env": "^10.0.0",
    "nx": "^21.3.10",
    "typescript": "^5.9.2"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ]
}
