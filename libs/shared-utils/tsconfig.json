{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "declaration": true,
    // 生成 .d.ts 类型文件
    "outDir": "../../dist/libs/shared-utils",
    // 输出目录
    "rootDir": "./src",
    // 源代码目录
    "strict": true,
    // 严格模式
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*"
  ],
  // 包含的文件
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}
